@Library('mlops-shared-lib') _

pipeline {
    agent any

    environment {
        MLFLOW_TRACKING_URI = "http://localhost:5000"
    }

    stages {
        stage('Data Ingest') {
            steps {
                script { mlUtils.ingestData() }
            }
        }

        stage('Model Train') {
            steps {
                script { mlUtils.trainModel() }
            }
        }

        stage('Model Deploy - MLflow') {
            steps {
                script {
                    def runId = mlUtils.getRunId()
                    mlUtils.deployModel("runs:/${runId}/model")
                }
            }
        }

        stage('Model Test') {
            steps {
                script {
                    def runId = mlUtils.getRunId()
                    mlUtils.testModel("runs:/${runId}/model")
                }
            }
            post {
                failure {
                    script {
                        notifyEmail('Dev', 'Model Test')
                    }
                }
            }
        }

        stage('Save Model - Challenger') {
            steps {
                script { mlUtils.registerModel('Challenger') }
            }
        }
    }
}
